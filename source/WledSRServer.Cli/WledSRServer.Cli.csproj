<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>WledSRServer</RootNamespace>
    <AssemblyName>wled-sr-server-cli</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FftSharp" Version="2.2.0" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
  </ItemGroup>

  <!-- Shared with WledSRServer.csproj (linked, not copied, so there's one source of truth) -->
  <ItemGroup>
    <Compile Include="..\WledSRServer\AudioSyncPacket.cs" Link="AudioSyncPacket.cs" />
    <Compile Include="..\WledSRServer\ServerContext.cs" Link="ServerContext.cs" />
    <Compile Include="..\WledSRServer\NetworkManager.cs" Link="NetworkManager.cs" />
    <Compile Include="..\WledSRServer\Properties\Settings.Designer.cs" Link="Properties\Settings.Designer.cs" />
    <Compile Include="..\WledSRServer\Audio\**\*.cs" Link="Audio\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
